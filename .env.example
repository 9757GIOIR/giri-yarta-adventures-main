# Frontend dev proxy target (Vite -> mail server)
BOOKING_API_TARGET=http://localhost:3001

# Mail server settings
BOOKING_SERVER_PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-mail@gmail.com

# Receiver email for booking details
SMTP_TO=giribalaji431@gmail.com
